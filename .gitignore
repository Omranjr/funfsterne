# Dependencies
node_modules/
.pnpm-store/

# Environment variables
.env
.env.local
.env.*.local

# Expo / React Native
.expo/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Next.js
.next/
out/

# Build outputs
dist/
build/
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS / Editor
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# Turborepo
# Local task cache and per-task logs. These are regenerated by every build and
# differ between machines, so committing them only produces noisy diffs.
.turbo/

# Wallet pass signing material
# The Apple Developer setup generates signerKey.pem, signerCert.pem and
# wwdr.pem locally, plus the .cer files they come from and the base64 blobs
# pasted into Render. The private key in particular can sign passes as this
# business, so none of it belongs in the repo.
*.pem
*.cer
*.certSigningRequest
*.b64
