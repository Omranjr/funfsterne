generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProductCategory {
  HAIR
  SKIN_CARE
  BEARD
  TOOLS
  OTHER
}

enum DiscountCodeType {
  PERCENTAGE
  FIXED
}

enum Platform {
  IOS
  ANDROID
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
}

enum LoyaltyRewardStatus {
  ACTIVE
  REDEEMED
}

enum NotificationAudience {
  ALL
  SEGMENT
}

enum TenantPlan {
  BASIC
  PRO
  ENTERPRISE
}

/// One white-label customer: one shop brand, one mobile app, one isolated
/// island of data.
///
/// `slug` is the identity the outside world uses -- it is what the mobile
/// app sends as `x-tenant-id` and what the scaffold script bakes into a new
/// customer's config. `id` is internal and is what every other table's
/// `tenantId` points at, so a slug could be renamed without rewriting the
/// whole database.
///
/// `isActive` is checked on every request: flipping it to false is how a
/// non-paying or off-boarded customer is switched off, and it takes effect
/// immediately rather than needing the data deleted.
model Tenant {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  plan      TenantPlan @default(BASIC)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  branches            Branch[]
  products            Product[]
  availabilities      ProductBranchAvailability[]
  discountCodes       DiscountCode[]
  redemptions         DiscountCodeRedemption[]
  pushTokens          PushToken[]
  notifications       Notification[]
  adminUsers          AdminUser[]
  consumerUsers       ConsumerUser[]
  loyaltyTransactions LoyaltyTransaction[]
  loyaltyRewards      LoyaltyReward[]
  categoryImages      CategoryImage[]

  @@index([isActive])
}

model Branch {
  id                     String                      @id @default(cuid())
  tenantId               String
  tenant                 Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                   String
  address                String
  city                   String
  postalCode             String
  phone                  String?
  isActive               Boolean                     @default(true)
  products               ProductBranchAvailability[]
  discountCodes          DiscountCode[]              @relation("DiscountCodeScopeBranch")
  redemptions            DiscountCodeRedemption[]
  loyaltyTransactions    LoyaltyTransaction[]
  loyaltyRewardsRedeemed LoyaltyReward[]
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  @@index([tenantId])
  @@index([isActive])
}

model Product {
  id             String                      @id @default(cuid())
  tenantId       String
  tenant         Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  category       ProductCategory
  basePrice      Decimal                     @db.Decimal(10, 2)
  images         String[]                    @default([])
  isActive       Boolean                     @default(true)
  availabilities ProductBranchAvailability[]
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@index([tenantId])
  @@index([category])
  @@index([isActive])
}

/// `tenantId` is denormalised here rather than reached through either
/// parent. It is redundant -- a row's product and branch already belong to
/// exactly one tenant -- but it means the scoping rule is the same one
/// sentence on every table, and a join row can never be written pairing one
/// tenant's product with another tenant's branch without the mismatch being
/// visible in this table's own data.
model ProductBranchAvailability {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId     String
  branchId      String
  inStock       Boolean  @default(true)
  priceOverride Decimal? @db.Decimal(10, 2)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([productId, branchId])
  @@index([tenantId])
  @@index([productId])
  @@index([branchId])
  @@index([inStock])
}

model DiscountCode {
  id                 String                   @id @default(cuid())
  tenantId           String
  tenant             Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code               String
  type               DiscountCodeType
  value              Decimal                  @db.Decimal(10, 2)
  expiresAt          DateTime?
  maxRedemptions     Int?
  currentRedemptions Int                      @default(0)
  isActive           Boolean                  @default(true)
  scopeBranchId      String?
  scopeBranch        Branch?                  @relation("DiscountCodeScopeBranch", fields: [scopeBranchId], references: [id], onDelete: SetNull)
  notifications      Notification[]
  redemptions        DiscountCodeRedemption[]

  // Was globally unique. Two shops must both be able to run a "WELCOME10",
  // and the redeem route now looks a code up by (tenantId, code) for exactly
  // this reason.
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([code])
  @@index([isActive])
  @@index([scopeBranchId])
}

model PushToken {
  id        String        @id @default(cuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deviceId  String
  userId    String?
  user      ConsumerUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Stays GLOBALLY unique, unlike the other constraints below. An Expo push
  // token identifies one installed app on one device; the same string can
  // never legitimately belong to two tenants, and scoping this per tenant
  // would let a stale row in tenant A keep receiving pushes meant for the
  // app that token now belongs to.
  token     String        @unique
  platform  Platform
  createdAt DateTime      @default(now())

  @@unique([tenantId, deviceId, token])
  @@index([tenantId])
  @@index([deviceId])
  @@index([platform])
  @@index([userId])
}

model DiscountCodeRedemption {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deviceId       String
  userId         String?
  user           ConsumerUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  branchId       String?
  discountCodeId String
  redeemedAt     DateTime      @default(now())
  branch         Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  discountCode   DiscountCode  @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)

  // Both of these were already effectively tenant-scoped, because
  // `discountCodeId` belongs to exactly one tenant. They are left as they
  // were rather than widened to include tenantId: adding a column that
  // cannot change the outcome would only make the index bigger and the
  // `where` clauses in the redeem route longer.
  @@unique([deviceId, discountCodeId])
  // Once a redemption is tied to a real account, block re-redemption across
  // devices too -- device-only dedup was the best we could do accountless,
  // but a logged-in user re-redeeming from a second phone should still be
  // caught. NULL userIds don't collide with each other in a unique index,
  // so this only bites once userId is actually set.
  @@unique([userId, discountCodeId])
  @@index([tenantId])
  @@index([deviceId])
  @@index([userId])
  @@index([discountCodeId])
  @@index([branchId])
}

model Notification {
  id             String               @id @default(cuid())
  tenantId       String
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title          String
  body           String
  discountCodeId String?
  discountCode   DiscountCode?        @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  // Defaulted so existing rows (all of which predate targeting, and were
  // therefore broadcasts) migrate to the correct value automatically.
  audience       NotificationAudience @default(ALL)
  sentAt         DateTime             @default(now())
  sentToCount    Int                  @default(0)

  @@index([tenantId])
  @@index([discountCodeId])
  @@index([sentAt])
}

model AdminUser {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Per tenant, not global: two shops may well be run by the same person,
  // and that person needs one login per shop. The login route resolves the
  // tenant from the header before looking the email up.
  @@unique([tenantId, email])
  @@index([tenantId])
}

/// Mobile consumer accounts. Deliberately no email or phone column -- only a
/// name and a chosen username/password, per product requirement. Password
/// recovery is admin-assisted (a reset, not a lookup: passwordHash is a
/// one-way hash and can't be reversed even by us).
model ConsumerUser {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firstName     String
  lastName      String
  username      String
  passwordHash  String
  /// Denormalized running total, kept in sync with LoyaltyTransaction inside
  /// the same DB transaction as every insert -- the ledger is the source of
  /// truth (and gives full history/audit), this is purely so the mobile app
  /// can read a balance without aggregating the whole ledger every time.
  loyaltyPoints Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pushTokens          PushToken[]
  redemptions         DiscountCodeRedemption[]
  loyaltyTransactions LoyaltyTransaction[]
  loyaltyRewards      LoyaltyReward[]

  // Per tenant, not global. Every shop gets its own namespace, so the
  // hundredth customer to want "mohamed" is only blocked if someone at the
  // same shop already took it.
  @@unique([tenantId, username])
  @@index([tenantId])
}

/// One row per point-earning or point-spending event. This is also, for
/// free, the "how often does this customer visit" record the admin
/// analytics dashboard reads from -- every EARN row is a visit.
model LoyaltyTransaction {
  id        String                 @id @default(cuid())
  tenantId  String
  tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Nullable + SetNull (not Cascade) so deleting an account still preserves
  /// anonymized visit/points-awarded history for aggregate business
  /// analytics, matching PushToken/DiscountCodeRedemption's existing pattern.
  userId    String?
  user      ConsumerUser?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  branchId  String?
  branch    Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  points    Int
  type      LoyaltyTransactionType
  note      String?
  createdAt DateTime               @default(now())

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([branchId])
  @@index([type])
}

/// An active or spent currency-value voucher, redeemed from accumulated
/// points. Unlike LoyaltyTransaction, this cascades on account deletion: an
/// ACTIVE voucher with no linked account is unredeemable and unverifiable in
/// person anyway (no account to check it against), so keeping it around as
/// an orphaned real-money liability is worse than removing it.
model LoyaltyReward {
  id                 String              @id @default(cuid())
  tenantId           String
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId             String
  user               ConsumerUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  eurosValue         Decimal             @db.Decimal(10, 2)
  pointsSpent        Int
  status             LoyaltyRewardStatus @default(ACTIVE)
  createdAt          DateTime            @default(now())
  redeemedAt         DateTime?
  redeemedByBranchId String?
  redeemedByBranch   Branch?             @relation(fields: [redeemedByBranchId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([status])
}

model CategoryImage {
  id        String          @id @default(cuid())
  tenantId  String
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// One row per fixed ProductCategory enum value, per tenant. Admin upserts
  /// via PUT /admin/category-images/:category, mobile reads via
  /// GET /public/category-images.
  ///
  /// This model gained a surrogate `id`: the category used to be the primary
  /// key, which made it globally unique -- one image per category for the
  /// whole platform, so the second tenant to upload a "BEARD" tile would
  /// have replaced the first tenant's.
  category  ProductCategory
  imageUrl  String
  updatedAt DateTime        @updatedAt
  createdAt DateTime        @default(now())

  @@unique([tenantId, category])
  @@index([tenantId])
}
