{
  "expo": {
    "name": "Fünf Sterne",
    "slug": "omm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "funfsterne",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.funfsterne.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "webcredentials:funfsterne-admin-eight.vercel.app"
      ]
    },
    "android": {
      "package": "com.funfsterne.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0A",
          "image": "./assets/splash-owner.png",
          "resizeMode": "cover",
          "dark": {
            "backgroundColor": "#0A0A0A",
            "image": "./assets/splash-owner.png",
            "resizeMode": "cover"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C9A84C"
        }
      ],
      "expo-font",
      "expo-localization"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "b62d0779-1c45-435f-975f-de76be0c6569"
      },
      "apiBaseUrl": "https://funfsterne-admin.onrender.com"
    },
    "owner": "omran808s-team"
  }
}
