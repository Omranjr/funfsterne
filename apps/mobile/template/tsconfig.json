{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "*": [
        "./node_modules/@types/*",
        "./node_modules/*",
        "../node_modules/@types/*",
        "../node_modules/*",
        "../../node_modules/@types/*",
        "../../node_modules/*",
        "../../../node_modules/@types/*",
        "../../../node_modules/*"
      ]
    },
    "types": ["node", "nativewind/types", "react-native-css-interop/types"]
  },
  "include": ["**/*.ts", "**/*.tsx", "../../../packages/core/src/**/*"],
  "exclude": ["node_modules"]
}
