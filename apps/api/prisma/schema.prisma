generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProductCategory {
  HAIR
  SKIN_CARE
  BEARD
  TOOLS
  OTHER
}

enum DiscountCodeType {
  PERCENTAGE
  FIXED
}

enum Platform {
  IOS
  ANDROID
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
}

enum LoyaltyRewardStatus {
  ACTIVE
  REDEEMED
}

enum NotificationAudience {
  ALL
  SEGMENT
}

model Branch {
  id          String                    @id @default(cuid())
  name        String
  address     String
  city        String
  postalCode  String
  phone       String?
  isActive    Boolean                   @default(true)
  products    ProductBranchAvailability[]
  discountCodes DiscountCode[]            @relation("DiscountCodeScopeBranch")
  redemptions DiscountCodeRedemption[]
  loyaltyTransactions LoyaltyTransaction[]
  loyaltyRewardsRedeemed LoyaltyReward[]
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([isActive])
}

model Product {
  id            String                    @id @default(cuid())
  name          String
  description   String?
  category      ProductCategory
  basePrice     Decimal                   @db.Decimal(10, 2)
  images        String[]                  @default([])
  isActive      Boolean                   @default(true)
  availabilities ProductBranchAvailability[]
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@index([category])
  @@index([isActive])
}

model ProductBranchAvailability {
  id            String   @id @default(cuid())
  productId     String
  branchId      String
  inStock       Boolean  @default(true)
  priceOverride Decimal? @db.Decimal(10, 2)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([productId, branchId])
  @@index([productId])
  @@index([branchId])
  @@index([inStock])
}

model DiscountCode {
  id                String                   @id @default(cuid())
  code              String                   @unique
  type              DiscountCodeType
  value             Decimal                  @db.Decimal(10, 2)
  expiresAt         DateTime?
  maxRedemptions    Int?
  currentRedemptions Int                     @default(0)
  isActive          Boolean                  @default(true)
  scopeBranchId     String?
  scopeBranch       Branch?                  @relation("DiscountCodeScopeBranch", fields: [scopeBranchId], references: [id], onDelete: SetNull)
  notifications     Notification[]
  redemptions       DiscountCodeRedemption[]

  @@index([code])
  @@index([isActive])
  @@index([scopeBranchId])
}

model PushToken {
  id        String        @id @default(cuid())
  deviceId  String
  userId    String?
  user      ConsumerUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  token     String        @unique
  platform  Platform
  createdAt DateTime      @default(now())
  // Bumped by the register upsert, which the app runs on every foreground --
  // so this is "last time we saw this device", which is what retention needs.
  // `createdAt` alone cannot tell a token refreshed daily for two years apart
  // from one whose phone was wiped the week it was issued.
  //
  // The `@default(now())` is there for the backfill: rows that already exist
  // when this column is added get today's date, i.e. a full retention window
  // starting at the deploy, rather than being swept on the very first run.
  updatedAt DateTime      @default(now()) @updatedAt

  @@unique([deviceId, token])
  @@index([deviceId])
  @@index([platform])
  @@index([userId])
  @@index([updatedAt])
}

model DiscountCodeRedemption {
  id             String        @id @default(cuid())
  deviceId       String
  userId         String?
  user           ConsumerUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  branchId       String?
  discountCodeId String
  redeemedAt     DateTime      @default(now())
  branch         Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  discountCode   DiscountCode  @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)

  @@unique([deviceId, discountCodeId])
  // Once a redemption is tied to a real account, block re-redemption across
  // devices too -- device-only dedup was the best we could do accountless,
  // but a logged-in user re-redeeming from a second phone should still be
  // caught. NULL userIds don't collide with each other in a unique index,
  // so this only bites once userId is actually set.
  @@unique([userId, discountCodeId])
  @@index([deviceId])
  @@index([userId])
  @@index([discountCodeId])
  @@index([branchId])
}

model Notification {
  id             String        @id @default(cuid())
  title          String
  body           String
  discountCodeId String?
  discountCode   DiscountCode? @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  // Defaulted so existing rows (all of which predate targeting, and were
  // therefore broadcasts) migrate to the correct value automatically.
  audience       NotificationAudience @default(ALL)
  sentAt         DateTime      @default(now())
  // Devices Expo ACCEPTED the message for. This is a queue count, not a
  // delivery count -- the fields below are what say whether it arrived.
  sentToCount    Int           @default(0)

  // Expo returns a ticket per message immediately, but the real outcome
  // (APNs/FCM accepted it, the token is dead, the push credentials are
  // rejected) only shows up in a *receipt* fetched later. Ticket ids are
  // kept here until that check runs; Expo discards them after 24h, so a
  // notification whose receipts were never fetched simply stays unknown.
  //
  // Each entry is "<ticketId>|<pushToken>". The token rides along because a
  // receipt only identifies itself by ticket id, and a `DeviceNotRegistered`
  // result is only actionable if you know which row to delete. Expo tokens
  // are of the form `ExponentPushToken[...]` and never contain "|".
  ticketIds        String[]  @default([])
  deliveryCheckedAt DateTime?
  deliveredCount   Int       @default(0)
  failedCount      Int       @default(0)
  // Distinct Expo error codes seen, e.g. "InvalidCredentials",
  // "DeviceNotRegistered". Surfaced in the admin so a silent, total
  // delivery failure is visible instead of looking like a successful send.
  deliveryErrors   String[]  @default([])

  @@index([discountCodeId])
  @@index([sentAt])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Mobile consumer accounts. Deliberately no email or phone column -- only a
// name and a chosen username/password, per product requirement. Password
// recovery is admin-assisted (a reset, not a lookup: passwordHash is a
// one-way hash and can't be reversed even by us).
model ConsumerUser {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  username     String   @unique
  passwordHash String
  // Denormalized running total, kept in sync with LoyaltyTransaction inside
  // the same DB transaction as every insert -- the ledger is the source of
  // truth (and gives full history/audit), this is purely so the mobile app
  // can read a balance without aggregating the whole ledger every time.
  loyaltyPoints Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pushTokens          PushToken[]
  redemptions         DiscountCodeRedemption[]
  loyaltyTransactions LoyaltyTransaction[]
  loyaltyRewards      LoyaltyReward[]
}

// One row per point-earning or point-spending event. This is also, for
// free, the "how often does this customer visit" record the admin
// analytics dashboard will read from later -- every EARN row is a visit.
model LoyaltyTransaction {
  id        String                 @id @default(cuid())
  // Nullable + SetNull (not Cascade) so deleting an account still preserves
  // anonymized visit/points-awarded history for aggregate business
  // analytics, matching PushToken/DiscountCodeRedemption's existing pattern.
  userId    String?
  user      ConsumerUser?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  branchId  String?
  branch    Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  points    Int
  type      LoyaltyTransactionType
  note      String?
  createdAt DateTime               @default(now())

  @@index([userId])
  @@index([userId, createdAt])
  @@index([branchId])
  @@index([type])
}

// An active or spent euro-value voucher, redeemed from accumulated points.
// Unlike LoyaltyTransaction, this cascades on account deletion: an ACTIVE
// voucher with no linked account is unredeemable and unverifiable in
// person anyway (no account to check it against), so keeping it around
// as an orphaned real-money liability is worse than removing it.
model LoyaltyReward {
  id                 String              @id @default(cuid())
  userId             String
  user               ConsumerUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  eurosValue         Decimal             @db.Decimal(10, 2)
  pointsSpent        Int
  status             LoyaltyRewardStatus @default(ACTIVE)
  createdAt          DateTime            @default(now())
  redeemedAt         DateTime?
  redeemedByBranchId String?
  redeemedByBranch   Branch?             @relation(fields: [redeemedByBranchId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

model CategoryImage {
  // One row per fixed ProductCategory enum value. Admin upserts via PUT
  // /admin/category-images/:category, mobile reads via GET /public/category-images.
  category  ProductCategory @unique
  imageUrl  String
  updatedAt DateTime        @updatedAt
  createdAt DateTime        @default(now())
}
