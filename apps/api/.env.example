# ── Database ──────────────────────────────────────────────────────────────
# The schema and migrations live in packages/db; this process only needs the
# connection string at runtime. Keep it identical to packages/db/.env.
DATABASE_URL="postgresql://postgres.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project_ref>:<password>@db.<project_ref>.supabase.co:5432/postgres"

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated. Fails CLOSED when unset: an unconfigured deployment allows
# no origins rather than reflecting any. Every tenant's admin dashboard
# origin has to be listed here.
ALLOWED_ORIGINS="http://localhost:3000"
ADMIN_ORIGIN="http://localhost:3000"
MOBILE_ORIGIN="exp://localhost:8081"

# ── Server ────────────────────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0

# ── Auth ──────────────────────────────────────────────────────────────────
# One secret signs every tenant's tokens. That is safe because each token
# carries a `tid` claim which is checked against the request's resolved
# tenant -- see src/middleware/tenant.ts. Rotating it signs out every tenant.
JWT_SECRET="change-me-in-production"

# ── Supabase Storage ──────────────────────────────────────────────────────
# One bucket, with uploads written under a per-tenant key prefix.
SUPABASE_URL="https://<project_ref>.supabase.co"
SUPABASE_SERVICE_KEY="<service_role_key>"
SUPABASE_STORAGE_BUCKET="product-images"

# ── Expo Push Notifications ───────────────────────────────────────────────
EXPO_ACCESS_TOKEN="<expo_access_token>"

# ── SMTP ──────────────────────────────────────────────────────────────────
# Only read by src/services/email.service.ts, which is dead code. Kept so the
# variables are documented if magic-link auth is ever revived.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
API_BASE_URL="http://localhost:4000"
