{
  "name": "funfsterne-platform",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/mobile/*",
    "apps/api",
    "apps/admin"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "mobile:funfsterne": "npm run start --workspace=@funfsterne/funfsterne",
    "mobile:mido": "npm run start --workspace=@funfsterne/mido-barber",
    "ios:funfsterne": "npm run start --workspace=@funfsterne/funfsterne -- --ios",
    "ios:mido": "npm run start --workspace=@funfsterne/mido-barber -- --ios",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check:core": "node scripts/check-core-is-brand-free.js",
    "check": "npm run check:core && npm run typecheck",
    "new-customer": "bash scripts/new-customer.sh",
    "build:all": "bash scripts/build-all.sh",
    "build:changed": "node scripts/build-changed.js",
    "db:migrate": "npm run migrate --workspace=@funfsterne/db",
    "db:migrate:deploy": "npm run migrate:deploy --workspace=@funfsterne/db",
    "db:generate": "npm run generate --workspace=@funfsterne/db",
    "db:seed": "npm run seed --workspace=@funfsterne/db",
    "db:validate": "npm run validate --workspace=@funfsterne/db",
    "api:dev": "npm run dev --workspace=@funfsterne/api",
    "admin:dev": "npm run dev --workspace=@funfsterne/admin",
    "postinstall": "npm run build --workspace=@funfsterne/shared-types && npm run generate --workspace=@funfsterne/db"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "nativewind": {
      "react": "19.1.0",
      "react-native": "0.81.5",
      "react-native-reanimated": "~4.1.1",
      "react-native-worklets": "0.5.1"
    }
  },
  "packageManager": "npm@10.0.0"
}
